<launch>

    <!-- what config we are going to run (should match folder name) -->
    <arg name="verbosity"       default="INFO" /> <!-- ALL, DEBUG, INFO, WARNING, ERROR, SILENT -->
    <arg name="config"          default="euroc_mav" /> <!-- euroc_mav, tum_vi, rpng_aruco, kaist -->
    <arg name="log_path"        default="$(find vio)/log" />
    <arg name="save_full_log"   default="false" />
    <arg name="save_tum_log"    default="true" />

    <!-- mono or stereo and what ros bag to play -->
    <arg name="bag_start"       default="0" />
    <arg name="dataset"         default="MH_01_easy" />
    <!-- <arg name="dataset"     default="MH_02_easy" /> -->
    <!-- <arg name="dataset"     default="MH_03_medium" /> -->
    <!-- <arg name="dataset"     default="MH_04_difficult" /> -->
    <!-- <arg name="dataset"     default="MH_05_difficult" /> -->

    <!-- <arg name="bag"         default="/media/gao/samsung/dataset/euroc_mav/$(arg dataset).bag" /> -->
    <!-- <arg name="bag"         default="/mnt/d/euroc_mav/MH_01_easy/$(arg dataset).bag" /> -->
    <arg name="bag_path"        default="/home/gao/dataset/euroc_mav/$(arg dataset).bag" />

    <!-- if show rviz -->
    <arg name="use_rviz"        default="false"/>
    <node if="$(arg use_rviz)"  pkg="rviz" type="rviz" name="rviz" args="-d $(find vio)/rviz/display.rviz"/>

    <!-- NN feature parameters -->
    <arg name="use_nn_feature"          default="false"/>
    <arg name="max_keypoints"           default="1024" />
    <arg name="use_gpu"                 default="true" />
    <arg name="confidence_threshold"    default="0.015" />

    <!-- MASTER NODE -->
    <node name="vio" pkg="vio" type="vio_serial_node" output="screen" clear_params="true" required="true">

        <param name="running_rate"              type="int"      value="20" /> <!--Hz-->
        <param name="set_init_timestamp_to_zero" type="bool"    value="true" />
        <param name="use_multi_thread"          type="bool"     value="true" />
        <param name="log_level"                 type="int"      value="0" /> <!-- 0: info, 1: warning, 2: error, 3: fatal -->
        <param name="save_full_log"             type="bool"     value="$(arg save_full_log)" />
        <param name="save_tum_log"              type="bool"     value="$(arg save_tum_log)" />
        <param name="solver_type"               type="int"      value="0" /> <!-- 0: eskf_solver, 1: sqrt_root_eskf_solver -->
        <param name="initial_type"              type="int"      value="1" /> <!-- 0: static initialization, 1: dynamic initialization -->
        <param name="estimate_ric"              type="bool"     value="true" />
        <param name="estimate_td_visual"        type="bool"     value="true" />
        <param name="frontend_prediction"       type="bool"     value="true" />
        <param name="use_zupt"                  type="bool"     value="false" />
        <param name="use_pnp_ransac"            type="bool"     value="true" />
        <param name="use_fej"                   type="bool"     value="true" />
        <param name="use_nn_feature"            type="bool"     value="$(arg use_nn_feature)" />
        <param name="lazy_time"                 type="double"   value="0.2" />

        <!-- bag parameters -->
        <param name="bag_name"                  type="str"      value="$(arg dataset)" />
        <param name="bag_path"                  type="str"      value="$(arg bag_path)" />
        <param name="bag_start"                 type="double"   value="0" />
        <param name="bag_duration"              type="double"   value="-1" />

        <!-- Camera configuration -->
        <param name="camera_num"                type="int"      value="2" />
        <param name="img_width"                 type="int"      value="752" />
        <param name="img_height"                type="int"      value="480" />
        <param name="use_census_transform"      type="bool"     value="false" />
        <rosparam param="intrinsic_cam_0">      [458.654, 457.296, 367.215, 248.375]                    </rosparam>
        <rosparam param="distortion_cam_0">     [-0.28340811, 0.07395907, 0.00019359, 1.76187114e-05]   </rosparam>
        <rosparam param="intrinsic_cam_1">      [457.587, 456.134, 379.999, 255.238]                    </rosparam>
        <rosparam param="distortion_cam_1">     [-0.28368365, 0.07451284, -0.00010473, -3.555907e-05]   </rosparam>

        <rosparam param="Tic">   [0.0148655429818, -0.999880929698,  0.004140296794,
                                  0.9995572490080,  0.014967213325,  0.025715529948,
                                 -0.0257744366974,  0.003756188358,  0.999660727178,
                                 -0.021640145497,  -0.064676986768,  0.009810730589,

                                  0.0125552670891, -0.999755099723,  0.018223771455,
                                  0.999598781151,   0.013011905182,  0.025158836311,
                                 -0.0253898008918,  0.017900583825,  0.999517347078,
                                 -0.019843557956,   0.045368942502,  0.007862124470]
        </rosparam>

        <param name="max_feat_n"                type="int"      value="$(eval arg('max_keypoints') if arg('use_nn_feature') else 300)" />
        <param name="grid_w"                    type="int"      value="$(eval 24 if arg('use_nn_feature') else 20)" />
        <param name="grid_h"                    type="int"      value="$(eval 18 if arg('use_nn_feature') else 15)" />
        <param name="max_clone_pose"            type="int"      value="6" />
        <param name="verbosity"                 type="str"      value="$(arg verbosity)" />
        <param name="log_path"                  type="str"      value="$(arg log_path)" />

        <param name="imu_acc_var_static_thres"  type="double"   value="0.5" />
        <param name="imu_gyro_static_thres"     type="double"   value="0.5" />
        <param name="gravity_magn"              type="double"   value="9.81" />

        <param name="sigma_na"                  type="double"   value="2.0000e-2" />
        <param name="sigma_nw"                  type="double"   value="1.6968e-03" />
        <param name="sigma_ba"                  type="double"   value="3.0000e-3" />
        <param name="sigma_bg"                  type="double"   value="1.9393e-03" />
        <param name="init_td_visual_sigma"      type="double"   value="1e-4" />
        <param name="init_ric_sigma"            type="double"   value="1e-3" />

        <rosparam param="camera_topic">   ["/cam0/image_raw", "/cam1/image_raw"]   </rosparam>
        <param name="imu_topic"                 type="str"      value="/imu0" />

    </node>

</launch>